# SABA Universal AI — Environment Configuration
# Copy this file to .env on your server.
# NEVER commit the real .env or any API key to GitHub.

PORT=3000

# OpenAI
OPENAI_API_KEY=your_openai_api_key_here
OPENAI_MODEL=gpt-5.6-luna
SABA_MODEL=gpt-5.6-luna

# SABA Image
SABA_IMAGE_MODEL=gpt-image-2
SABA_IMAGE_DEFAULT_QUALITY=medium
SABA_IMAGE_DEFAULT_SIZE=auto
SABA_IMAGE_DEFAULT_FORMAT=png

# Supabase
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_PUBLISHABLE_KEY=your_supabase_publishable_key
SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_key

# Guest/client protection
GUEST_RATE_SALT=replace_with_a_long_random_secret

NODE_ENV=production
