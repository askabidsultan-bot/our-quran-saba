# SABA Universal AI backend
PORT=3000

# Required
OPENAI_API_KEY=your_openai_api_key_here

# Optional chat model. Luis 1.2 uses this unless SABA_MODEL_LUIS_1_2 is set.
SABA_MODEL=gpt-5.6-luna
SABA_MODEL_LUIS_1_2=

# Image generation
SABA_IMAGE_MODEL=gpt-image-2
SABA_IMAGE_QUALITY=medium
SABA_IMAGE_SIZE=auto
SABA_IMAGE_OUTPUT_FORMAT=png
SABA_IMAGE_PARTIALS=2

# Voice transcription
SABA_TRANSCRIBE_MODEL=gpt-transcribe

# Optional Supabase durable image storage / auth
SUPABASE_URL=
SUPABASE_PUBLISHABLE_KEY=
SUPABASE_SERVICE_ROLE_KEY=
SABA_IMAGE_BUCKET=saba-images

# Optional guest-rate salt
GUEST_RATE_SALT=change-this-secret
